ENVIRONMENT=production
HOST=127.0.0.1
PORT=5000
TRUST_PROXY=loopback
CSRF_MODE=token

MONGO_CONN=mongodb+srv://USERNAME:PASSWORD@PRIVATE_CLUSTER/
MONGO_DB_NAME=thyncspace_prod

# Generate two different values with at least 32 characters each.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
COLLABORATION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

CLIENT_URL=https://thyncspace.bg-labs.com
GOOGLE_AUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_AUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://thyncspace-api.bg-labs.com/api/auth/google/callback
