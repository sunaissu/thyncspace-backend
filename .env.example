ENVIRONMENT=production
HOST=127.0.0.1
PORT=5000
TRUST_PROXY=loopback
CSRF_MODE=token

# Active production mode: obtain temporary credentials from the attached EC2 IAM role.
MONGO_AUTH_MODE=aws-iam
MONGO_CONN=mongodb+srv://ATLAS_HOST/?authSource=%24external&authMechanism=MONGODB-AWS
MONGO_DB_NAME=thyncspace_prod

# Optional read-through cache. Leave REDIS_URL empty to use MongoDB directly.
# Remote production Redis must use TLS (rediss://). Local Redis may use redis://.
REDIS_URL=
# REDIS_URL=rediss://USERNAME:PASSWORD@REDIS_HOST:6379
REDIS_CACHE_TTL_SECONDS=30

# Future non-AWS/password deployment (use one mode and one URI, never both):
# MONGO_AUTH_MODE=password
# MONGO_CONN=mongodb+srv://URL_ENCODED_USERNAME:URL_ENCODED_PASSWORD@ATLAS_HOST/?retryWrites=true&w=majority

# Generate two different values with at least 32 characters each.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
COLLABORATION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

CLIENT_URL=https://thyncspace.bg-labs.com
GOOGLE_AUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_AUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://thyncspace-api.bg-labs.com/api/auth/google/callback

# Optional selected-passage AI. Server-side credentials only; disabled by default.
AI_ACTIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_AI_MODEL=
